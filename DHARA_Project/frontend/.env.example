# Address the visitor's BROWSER uses to reach the Go API (public site forms + the admin panel).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Address the Next.js SERVER uses to reach the API while rendering pages.
# Leave unset when running locally (it falls back to the value above).
# In Docker set it to the internal service address, e.g. http://backend:8080/api/v1
# API_INTERNAL_URL=http://backend:8080/api/v1

# Used only by the /uploads proxy rewrite (read at build time).
# BACKEND_URL=http://127.0.0.1:8080

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=94763774551
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Demo mode: show bundled sample content when no backend is running. Leave OFF for real use.
# USE_FALLBACK_DATA=true
