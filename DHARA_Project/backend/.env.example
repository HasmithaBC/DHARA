PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dhara?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_HRS=168
ALLOWED_ORIGINS=http://localhost:3000
SIGNED_URL_SECRET=change-me-too

# Email (SendGrid v3 transactional API). Leave SENDGRID_API_KEY blank to log emails
# to stdout instead of sending — useful for local dev.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@dharact.com
SALES_INBOX_EMAIL=sales@dharact.com

# Bot mitigation (NFRSEC-002). Leave blank to skip verification in local dev.
TURNSTILE_SECRET=

# Media uploads (FR-ADM-004 / NFR-SEC-007)
MEDIA_UPLOAD_DIR=./uploads
MAX_IMAGE_BYTES=10485760
MAX_PDF_BYTES=20971520

SITE_BASE_URL=https://dharact.com
FRONTEND_BASE_URL=https://dharact.com

# Optional WhatsApp Business Platform notification on high-intent leads (FR-NOT-005, P2).
# Requires a Meta WhatsApp Business account provisioned by the client (SRS Appendix E #5).
# Leave blank to disable — high-intent leads are logged instead.
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SALES_NUMBER=
HIGH_INTENT_OFFER_THRESHOLD_LKR=10000000
